# Which LLM answers: gemini (default) or anthropic (Claude). Both need GOOGLE_API_KEY because few-shot
# retrieval uses Gemini embeddings; Claude additionally needs ANTHROPIC_API_KEY.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Optional: override the provider's default model (gemini-3.5-flash-lite / claude-haiku-5-5)
# MODEL_NAME=
DB_PATH=data/northwind_small.db
